<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" name="Anmeldung &amp; Netzanschlussprüfung EEG-Anlage bis Inbetriebnahme &amp; erste Abrechnung" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="Kunde/Fachpartner">
        <bpmn:flowNodeRef>TASK_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_18</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Netzportal">
        <bpmn:flowNodeRef>TASK_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Netzbetreiber – TSP">
        <bpmn:flowNodeRef>TASK_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GATEWAY_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GATEWAY_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GATEWAY_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GATEWAY_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GATEWAY_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_27</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="PowerFactory">
        <bpmn:flowNodeRef>TASK_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="NetzKoKalk">
        <bpmn:flowNodeRef>TASK_14</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_6" name="Netzbetreiber – TSBZ">
        <bpmn:flowNodeRef>GATEWAY_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TASK_26</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_7" name="Netzplanung">
        <bpmn:flowNodeRef>TASK_21</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START_1" name="Anfrage zur Anmeldung einer EEG-Anlage"/>
    <bpmn:userTask id="TASK_1" name="EEG-Anlage anmelden"/>
    <bpmn:serviceTask id="TASK_2" name="Daten an Lovion Work übergeben"/>
    <bpmn:userTask id="TASK_3" name="Vollständigkeit der Unterlagen prüfen"/>
    <bpmn:exclusiveGateway id="GATEWAY_1" name="Unterlagen vollständig?"/>
    <bpmn:userTask id="TASK_4" name="Rückfrage an Antragsteller"/>
    <bpmn:userTask id="TASK_5" name="Fehlende Dokumente nachreichen"/>
    <bpmn:exclusiveGateway id="GATEWAY_2" name="Anlagenleistung &lt; 15 kWp?"/>
    <bpmn:userTask id="TASK_6" name="Trafo-Überlastung prüfen"/>
    <bpmn:exclusiveGateway id="GATEWAY_3" name="Trafo überlastet?"/>
    <bpmn:userTask id="TASK_7" name="Netzanschluss genehmigen"/>
    <bpmn:task id="TASK_8" name="Netzverstärkung erforderlich"/>
    <bpmn:task id="TASK_21" name="Subprozess Netzplanung durchführen"/>
    <bpmn:serviceTask id="TASK_9" name="Genehmigung per Mail versenden"/>
    <bpmn:userTask id="TASK_10" name="Antrag bestätigen &amp; Vorbereitung Netzberechnung"/>
    <bpmn:exclusiveGateway id="GATEWAY_4" name="Betriebsmittel digitalisiert?"/>
    <bpmn:userTask id="TASK_11" name="Betriebsmittel digitalisieren"/>
    <bpmn:serviceTask id="TASK_12" name="Betriebsmittel in PowerFactory übernehmen"/>
    <bpmn:userTask id="TASK_13" name="Netzberechnung durchführen"/>
    <bpmn:serviceTask id="TASK_14" name="Netzausbaukosten ermitteln"/>
    <bpmn:exclusiveGateway id="GATEWAY_5" name="Kosten wirtschaftlich zumutbar?"/>
    <bpmn:userTask id="TASK_15" name="Netzanschluss genehmigen &amp; ggf. Kostenvoranschlag"/>
    <bpmn:userTask id="TASK_18" name="Errichtungsbestätigung einreichen"/>
    <bpmn:intermediateCatchEvent id="EVENT_TIMER_1" name="12-Wochen-Frist zur Errichtungsbestätigung"/>
    <bpmn:endEvent id="END_ABORT" name="Genehmigung verfallen"/>
    <bpmn:userTask id="TASK_19" name="Unterlagen an TSBZ weiterleiten"/>
    <bpmn:exclusiveGateway id="GATEWAY_6" name="Anlage &lt; 135 kWp?"/>
    <bpmn:userTask id="TASK_20" name="Zählerwesen-Unterlagen prüfen"/>
    <bpmn:userTask id="TASK_22" name="Optional: Prüfung für Anlagen ≥135 kWp"/>
    <bpmn:userTask id="TASK_16" name="Inbetriebnahme freigeben"/>
    <bpmn:userTask id="TASK_17" name="Antragsteller informieren"/>
    <bpmn:userTask id="TASK_23" name="Inbetriebnahmeauftrag an TSBZ"/>
    <bpmn:userTask id="TASK_24" name="Zählermontage mit Antragsteller koordinieren"/>
    <bpmn:userTask id="TASK_25" name="Zähler installieren"/>
    <bpmn:userTask id="TASK_26" name="Inbetriebnahme durchführen"/>
    <bpmn:serviceTask id="TASK_27" name="Abrechnung &amp; Stammdatenregistermeldung"/>
    <bpmn:endEvent id="END_SUCCESS" name="Erste Abrechnung erfolgt"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="START_1" targetRef="TASK_1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="TASK_1" targetRef="TASK_2"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="TASK_2" targetRef="TASK_3"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="TASK_3" targetRef="GATEWAY_1"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="GATEWAY_1" targetRef="TASK_4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nein</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="GATEWAY_1" targetRef="GATEWAY_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ja</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="TASK_4" targetRef="TASK_5"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="TASK_5" targetRef="TASK_3"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="GATEWAY_2" targetRef="TASK_6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ja (&lt;15 kWp)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="GATEWAY_2" targetRef="TASK_10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nein (≥15 kWp)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="TASK_6" targetRef="GATEWAY_3"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="GATEWAY_3" targetRef="TASK_7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nein</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="GATEWAY_3" targetRef="TASK_8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ja</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="TASK_8" targetRef="TASK_21"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="TASK_21" targetRef="TASK_7"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="TASK_7" targetRef="TASK_9"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="TASK_10" targetRef="GATEWAY_4"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="GATEWAY_4" targetRef="TASK_11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nein</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="GATEWAY_4" targetRef="TASK_12">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ja</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="TASK_11" targetRef="TASK_12"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="TASK_12" targetRef="TASK_13"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="TASK_13" targetRef="TASK_14"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="TASK_14" targetRef="GATEWAY_5"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="GATEWAY_5" targetRef="TASK_15">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ja</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="GATEWAY_5" targetRef="TASK_8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nein</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="TASK_15" targetRef="TASK_9"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="TASK_9" targetRef="TASK_18"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="TASK_18" targetRef="TASK_19"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="TASK_18" targetRef="EVENT_TIMER_1"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="EVENT_TIMER_1" targetRef="END_ABORT">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">keine Einreichung nach 12 Wochen</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="TASK_19" targetRef="GATEWAY_6"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="GATEWAY_6" targetRef="TASK_20">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">ja</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="GATEWAY_6" targetRef="TASK_22">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nein</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="TASK_20" targetRef="TASK_16"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="TASK_22" targetRef="TASK_16"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="TASK_16" targetRef="TASK_17"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="TASK_17" targetRef="TASK_23"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="TASK_23" targetRef="TASK_24"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="TASK_24" targetRef="TASK_25"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="TASK_25" targetRef="TASK_26"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="TASK_26" targetRef="TASK_27"/>
    <bpmn:sequenceFlow id="Flow_42" sourceRef="TASK_27" targetRef="END_SUCCESS"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1"/>
